---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { visiblePosts } from '../../lib/posts';
const posts = await visiblePosts();
---
<Base title="전체 글" description="공부와 일상에 관한 기록을 최신순으로 모았습니다.">
  <section class="page-shell"><header class="page-heading"><p class="eyebrow">ALL NOTES</p><h1>전체 글</h1><p>공부와 일상, 차곡차곡 쌓아 가는 기록.</p></header>
    {import.meta.env.DEV && <p class="preview-note">로컬 작성 미리보기 · 초안을 포함합니다.</p>}
    <PostList posts={posts} />
  </section>
</Base>
