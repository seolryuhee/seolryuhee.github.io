---
import Base from '../layouts/Base.astro';
import { visiblePosts } from '../lib/posts';
import PostList from '../components/PostList.astro';
import { urlFor } from '../lib/site.mjs';
const posts = (await visiblePosts()).slice(0, 6);
---
<Base>
  <section class="home-intro">
    <p class="eyebrow">SEOLRYUHEE’S NOTES</p>
    <h1>배운 것과 지나온 날들을<br />천천히 기록합니다<span class="title-dot">.</span></h1>
    <p class="intro-copy">코드를 읽고, 생각을 정리하고, 일상의 작은 장면을 남깁니다.<br class="desktop-break" />가끔 쓰더라도 오래 꺼내 볼 수 있는 기록이었으면 합니다.</p>
    <div class="intro-detail"><span aria-hidden="true">✳</span> 공부와 일상 사이의 작은 공간</div>
  </section>
  <section class="recent-posts" aria-labelledby="recent-title">
    <div class="section-heading"><h2 id="recent-title">최근 기록</h2><a href={urlFor('posts/')}>전체 글 보기 →</a></div>
    {import.meta.env.DEV && <p class="preview-note">로컬 작성 미리보기 · 초안을 포함합니다.</p>}
    <PostList posts={posts} />
  </section>
</Base>
