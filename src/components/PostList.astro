---
import { formatDate } from '../lib/posts';
import { tagPath, urlFor } from '../lib/site.mjs';
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'posts'>[] }
const { posts } = Astro.props;
---
{posts.length ? <div>{posts.map(post => <article class="post-row">
  <div class="post-meta"><time datetime={post.data.date}>{formatDate(post.data.date)}</time>{post.data.draft && <span class="draft-badge">초안</span>}</div>
  <h3><a href={urlFor(`posts/${post.data.slug}/`)}>{post.data.title}<span class="row-arrow" aria-hidden="true">↗</span></a></h3>
  <p>{post.data.summary}</p>
  <div class="tag-list">{post.data.tags.map(tag => <a href={tagPath(tag)}>{tag}</a>)}</div>
</article>)}</div> : <div class="empty-state"><span aria-hidden="true">✳</span><h3>첫 기록을 준비하고 있습니다.</h3><p>새 글이 게시되면 이곳에서 만날 수 있습니다.</p></div>}
